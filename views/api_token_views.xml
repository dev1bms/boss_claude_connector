<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_boss_claude_api_token_tree" model="ir.ui.view">
        <field name="name">boss.claude.api.token.tree</field>
        <field name="model">boss.claude.api.token</field>
        <field name="arch" type="xml">
            <tree string="API Tokens">
                <field name="name"/>
                <field name="profile_id"/>
                <field name="active"/>
                <field name="token_preview"/>
                <field name="last_used_at"/>
                <field name="expires_at"/>
            </tree>
        </field>
    </record>

    <record id="view_boss_claude_api_token_form" model="ir.ui.view">
        <field name="name">boss.claude.api.token.form</field>
        <field name="model">boss.claude.api.token</field>
        <field name="arch" type="xml">
            <form string="API Token">
                <header>
                    <button name="action_generate_token" type="object"
                            string="Generate Token" class="oe_highlight"
                            confirm="A new token will be generated. The old one (if any) becomes invalid. Continue?"/>
                    <button name="action_revoke" type="object"
                            string="Revoke" invisible="not active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Revoked" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Desktop Claude Client"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="active"/>
                            <field name="expires_at"/>
                        </group>
                        <group>
                            <field name="token_preview"/>
                            <field name="last_used_at"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_boss_claude_api_token" model="ir.actions.act_window">
        <field name="name">API Tokens</field>
        <field name="res_model">boss.claude.api.token</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Token display wizard -->
    <record id="view_boss_claude_token_wizard_form" model="ir.ui.view">
        <field name="name">boss.claude.token.wizard.form</field>
        <field name="model">boss.claude.token.wizard</field>
        <field name="arch" type="xml">
            <form string="API Token Generated">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <field name="warning" readonly="1" nolabel="1" class="fw-bold"/>
                    </div>
                    <group>
                        <field name="raw_token" readonly="1" nolabel="1"
                               widget="CopyClipboardChar"
                               style="font-family:monospace;"/>
                    </group>
                    <footer>
                        <button string="Close" type="object" name="action_close" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
