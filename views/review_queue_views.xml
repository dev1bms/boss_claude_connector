<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_boss_claude_review_queue_tree" model="ir.ui.view">
        <field name="name">boss.claude.review.queue.tree</field>
        <field name="model">boss.claude.review.queue</field>
        <field name="arch" type="xml">
            <tree string="AI Review Queue" create="false"
                  decoration-info="status=='pending'"
                  decoration-success="status=='approved'"
                  decoration-muted="status=='rejected'"
                  decoration-primary="status=='applied'"
                  decoration-danger="status=='error'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="target_module"/>
                <field name="target_model"/>
                <field name="target_record_id"/>
                <field name="target_operation"/>
                <field name="normalized_key"/>
                <field name="normalized_value"/>
                <field name="confidence"/>
                <field name="access_profile_id"/>
                <field name="token_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_boss_claude_review_queue_form" model="ir.ui.view">
        <field name="name">boss.claude.review.queue.form</field>
        <field name="model">boss.claude.review.queue</field>
        <field name="arch" type="xml">
            <form string="AI Review Queue">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="oe_highlight"
                            invisible="status != 'pending'"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            invisible="status not in ('pending','approved')"/>
                    <button name="action_apply" type="object"
                            string="Apply" class="oe_highlight"
                            invisible="status != 'approved'"
                            confirm="Apply this suggestion to the target Odoo model. Permissions and draft-only rules will be re-checked. Continue?"/>
                    <button name="action_reset_to_pending" type="object"
                            string="Reset to Pending"
                            invisible="status in ('pending','applied')"
                            groups="boss_claude_connector.group_boss_claude_admin"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,approved,applied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Target">
                            <field name="target_module"/>
                            <field name="target_model"/>
                            <field name="target_record_id"/>
                            <field name="target_operation"/>
                        </group>
                        <group string="Suggestion">
                            <field name="normalized_key"/>
                            <field name="normalized_value"/>
                            <field name="confidence"/>
                        </group>
                    </group>
                    <group>
                        <group string="Origin">
                            <field name="access_profile_id"/>
                            <field name="token_id"/>
                            <field name="request_log_id"/>
                        </group>
                        <group string="Lifecycle">
                            <field name="approved_by_id"/>
                            <field name="approved_date"/>
                            <field name="applied_date"/>
                            <field name="applied_record_model"/>
                            <field name="applied_record_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload (JSON)">
                            <field name="payload_json" widget="text"
                                   placeholder='{"values": {"name": "..."}}'/>
                        </page>
                        <page string="Source">
                            <field name="source_text"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Error" invisible="not error_message">
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_boss_claude_review_queue_search" model="ir.ui.view">
        <field name="name">boss.claude.review.queue.search</field>
        <field name="model">boss.claude.review.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="target_model"/>
                <field name="target_module"/>
                <field name="normalized_key"/>
                <field name="normalized_value"/>
                <field name="access_profile_id"/>
                <field name="token_id"/>
                <filter name="pending" string="Pending" domain="[('status','=','pending')]"/>
                <filter name="approved" string="Approved" domain="[('status','=','approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('status','=','rejected')]"/>
                <filter name="applied" string="Applied" domain="[('status','=','applied')]"/>
                <filter name="error" string="Error" domain="[('status','=','error')]"/>
                <separator/>
                <filter name="op_create" string="Create" domain="[('target_operation','=','create')]"/>
                <filter name="op_write" string="Write" domain="[('target_operation','=','write')]"/>
                <filter name="op_post_note" string="Post Note" domain="[('target_operation','=','post_note')]"/>
                <filter name="op_suggest" string="Suggestion" domain="[('target_operation','=','suggest')]"/>
                <group string="Group By">
                    <filter name="g_status" string="Status" context="{'group_by':'status'}"/>
                    <filter name="g_model" string="Target Model" context="{'group_by':'target_model'}"/>
                    <filter name="g_op" string="Operation" context="{'group_by':'target_operation'}"/>
                    <filter name="g_profile" string="Profile" context="{'group_by':'access_profile_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_boss_claude_review_queue" model="ir.actions.act_window">
        <field name="name">AI Review Queue</field>
        <field name="res_model">boss.claude.review.queue</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

</odoo>
