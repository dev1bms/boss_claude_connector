<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Optional generic seed using boss.claude.normalization.rule.
         Scope is module='boss_charge_codes' so it does not collide with
         rules for real Odoo models. Users can disable or delete freely. -->
    <data noupdate="1">

        <record id="nr_fai" model="boss.claude.normalization.rule">
            <field name="name">FAI - Freight Air Import</field>
            <field name="module">boss_charge_codes</field>
            <field name="field">boss_code</field>
            <field name="raw_value">flete aereo import</field>
            <field name="normalized_value">FAI</field>
            <field name="match_type">contains</field>
            <field name="confidence">0.95</field>
        </record>

        <record id="nr_fae" model="boss.claude.normalization.rule">
            <field name="name">FAE - Freight Air Export</field>
            <field name="module">boss_charge_codes</field>
